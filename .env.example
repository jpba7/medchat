# ----------------------------------------------------------------------------
# MedChat — exemplo de variáveis de ambiente.
# Copie este arquivo para `.env` e preencha. Nunca commitar `.env`.
# ----------------------------------------------------------------------------

# Django ---------------------------------------------------------------------

# Em dev pode usar default inseguro de base.py. Em prod é obrigatório.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados -------------------------------------------------------------

DATABASE_URL=postgres://medchat:medchat@localhost:5432/medchat

# Redis / Celery -------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Anthropic (LLM principal) --------------------------------------------------

ANTHROPIC_API_KEY=

# OpenRouter (fallback de LLM) -----------------------------------------------

OPENROUTER_API_KEY=

# Langfuse (observabilidade AI self-hosted) ----------------------------------

LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Secrets do container Langfuse (gere com `openssl rand -hex 32`).
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# Evolution API (WhatsApp MVP) -----------------------------------------------

EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=

# Cryptography ---------------------------------------------------------------

# Chave Fernet para criptografar credenciais por canal.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
